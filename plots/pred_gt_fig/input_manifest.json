{
  "schema_version": 1,
  "description": "Inputs for reproducing the sparse-vector prediction-versus-ground-truth figures.",
  "array_contract": {
    "format": "NumPy .npy",
    "shape": "A numeric time sequence that is one-dimensional after numpy.squeeze.",
    "prediction_semantics": "Binary point-level anomaly decisions, where values greater than 0.5 are anomalous.",
    "ground_truth_semantics": "Binary point-level anomaly labels, where values greater than 0.0 define anomaly segments.",
    "length_semantics": "Lengths may differ between model adapters. Each model keeps its paired ground-truth sequence so the historical global alignment can be reproduced."
  },
  "datasets": [
    {
      "id": "swat",
      "prediction_dilation_radius": 20,
      "alignment_segment": 0
    },
    {
      "id": "wadi",
      "prediction_dilation_radius": 10,
      "alignment_segment": 1
    }
  ],
  "models": [
    {"id": "knn", "display_name": "KNN"},
    {"id": "ocsvm", "display_name": "OCSVM"},
    {"id": "deepsvdd", "display_name": "DeepSVDD"},
    {"id": "usad", "display_name": "USAD"},
    {"id": "tsmixer", "display_name": "TSMixer"},
    {"id": "anomalytransformer", "display_name": "AnomalyTrans"},
    {"id": "fusagnet", "display_name": "FuSAGNet"},
    {"id": "mtscid", "display_name": "MtsCID"},
    {"id": "mshtrans", "display_name": "MSHTrans"},
    {"id": "stager", "display_name": "STAGER"}
  ],
  "subset_models": ["tsmixer", "mshtrans", "fusagnet", "stager"],
  "files": {
    "swat": {
      "knn": {"prediction": "swat/knn/prediction.npy", "ground_truth": "swat/knn/ground_truth.npy"},
      "ocsvm": {"prediction": "swat/ocsvm/prediction.npy", "ground_truth": "swat/ocsvm/ground_truth.npy"},
