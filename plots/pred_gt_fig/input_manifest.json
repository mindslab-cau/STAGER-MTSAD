      "tsmixer": {"prediction": "swat/tsmixer/prediction.npy", "ground_truth": "swat/tsmixer/ground_truth.npy"},
      "anomalytransformer": {"prediction": "swat/anomalytransformer/prediction.npy", "ground_truth": "swat/anomalytransformer/ground_truth.npy"},
      "fusagnet": {"prediction": "swat/fusagnet/prediction.npy", "ground_truth": "swat/fusagnet/ground_truth.npy"},
      "mtscid": {"prediction": "swat/mtscid/prediction.npy", "ground_truth": "swat/mtscid/ground_truth.npy"},
      "mshtrans": {"prediction": "swat/mshtrans/prediction.npy", "ground_truth": "swat/mshtrans/ground_truth.npy"},
